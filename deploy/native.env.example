# 原生 systemd 配置：安装为 /etc/wildhaven.env，root:root，权限 600。
# 示例口令会阻止启动；用 openssl rand -hex 32 生成并替换。
HOST=127.0.0.1
PORT=3001
PRIVATE_MODE=true
ADMIN_TOKEN=replace-with-a-long-random-secret
# 先通过 SSH 隧道检查时可留空；经现有 HTTPS 域名访问时填完整源，无末尾斜杠。
PUBLIC_ORIGIN=
IDLE_TIMEOUT_SECONDS=1800
DB_PATH=/var/lib/wildhaven/world.sqlite
WORLD_WIDTH=512
WORLD_HEIGHT=384
WORLD_SEED=42
MAX_ANIMALS=800
MAX_CLIENTS=1
TICK_HZ=5
PUSH_HZ=1
SAVE_SECONDS=60
