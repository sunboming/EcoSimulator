# 复制为 .env；生产环境请替换口令（例如 openssl rand -hex 32）。
PORT=3000
BIND_IP=127.0.0.1
PRIVATE_MODE=true
IDLE_TIMEOUT_SECONDS=1800
ADMIN_TOKEN=replace-with-a-long-random-secret
PUBLIC_ORIGIN=
WORLD_WIDTH=512
WORLD_HEIGHT=384
WORLD_SEED=42
MAX_ANIMALS=1200
MAX_CLIENTS=1
TICK_HZ=5
PUSH_HZ=2
SAVE_SECONDS=30
MEM_LIMIT=256m
CPU_LIMIT=0.50
NODE_HEAP_MB=128
